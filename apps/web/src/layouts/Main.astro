---
import CoffeeIcon from '~/assets/icons/CoffeeIcon.astro'
import CopyLeftIcon from '~/assets/icons/CopyLeftIcon.astro'
import HeartIcon from '~/assets/icons/HeartIcon.astro'
import MenuIcon from '~/assets/icons/MenuIcon.astro'
import '~/styles/globals.css'

const isProduction = import.meta.env.PROD
const { title } = Astro.props
const { user } = Astro.locals
---

<!doctype html>
<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width' />
    <link rel='icon' type='image/svg+xml' href='/favicon.svg' />
    <meta name='generator' content={Astro.generator} />
    <title>Fullstack Nest + Astro {title && `| ${title}`}</title>

    {
      isProduction && (
        <script
          is:inline
          defer
          data-domain='fab.tuxlab.fr'
          src='https://analitycs.tuxlab.fr/js/script.outbound-links.js'
        />
      )
    }
  </head>
  <body class='min-h-screen'>
    <header class='navbar bg-base-300'>
      <nav class='mx-auto flex w-full max-w-7xl items-center gap-4'>
        <div class='flex-none'>
          <a href='/' class='btn btn-ghost text-lg'>Home</a>
        </div>
        <ul class='menu menu-horizontal hidden flex-1 gap-1 lg:flex'>
          {
            user ? (
              <>
                <li>
                  <a href='/'>Tableau de bord</a>
                </li>
                <li>
                  <a href='/vehicle'>Mon véhicule</a>
                </li>
                <li>
                  <a href='/check-types'>Contrôles</a>
                </li>
                <li>
                  <a href='/check-logs'>Historique</a>
                </li>
              </>
            ) : null
          }
        </ul>
        <div class='hidden flex-none gap-1 lg:flex'>
          {
            user ? (
              <>
                <a href='/profile' class='btn btn-ghost'>
                  {user.username.charAt(0).toUpperCase() + user.username.slice(1)}
                </a>
                {user.role === 'admin' && (
                  <a href='/admin' class='btn btn-ghost'>
                    Admin
                  </a>
                )}
                <a href='/auth/logout' class='btn btn-ghost'>
                  Logout
                </a>
              </>
            ) : (
              <a href='/auth' class='btn btn-ghost'>
                Login
              </a>
            )
          }
        </div>
        <div class='flex flex-1 justify-end lg:hidden'>
          <details class='dropdown dropdown-end'>
            <summary class='btn btn-ghost' aria-label='Open main menu'>
              <MenuIcon />
            </summary>
            <ul class='dropdown-content menu bg-base-200 rounded-box z-10 w-52 p-2 shadow'>
              {
                user ? (
                  <>
                    <li>
                      <a href='/'>Tableau de bord</a>
                    </li>
                    <li>
                      <a href='/vehicle'>Mon véhicule</a>
                    </li>
                    <li>
                      <a href='/check-types'>Contrôles</a>
                    </li>
                    <li>
                      <a href='/check-logs'>Historique</a>
                    </li>
                    <li>
                      <a href='/profile'>
                        {user.username.charAt(0).toUpperCase() + user.username.slice(1)}
                      </a>
                    </li>
                    {user.role === 'admin' && (
                      <li>
                        <a href='/admin'>Admin</a>
                      </li>
                    )}
                    <li>
                      <a href='/auth/logout'>Logout</a>
                    </li>
                  </>
                ) : (
                  <li>
                    <a href='/auth'>Login</a>
                  </li>
                )
              }
            </ul>
          </details>
        </div>
      </nav>
    </header>
    <main class='mx-auto flex w-full max-w-7xl flex-1 flex-col py-6'>
      <slot />
    </main>
    <footer class='footer footer-center bg-base-300 text-base-content p-6'>
      <div>
        <p class='flex items-center justify-center gap-1 font-semibold'>
          <CopyLeftIcon class='inline size-4' />
          {new Date().getFullYear()} Fullstack Nest + Astro.
        </p>
        <p>
          Built by <a
            class='link link-primary font-semibold'
            href='https://github.com/TituxMetal'
            target='_blank'
            rel='noopener noreferrer'>Lgdweb</a
          > with <HeartIcon class='text-error inline size-6' /> and lots of <CoffeeIcon
            class='text-warning inline size-6'
          />.
        </p>
      </div>
    </footer>
  </body>
</html>
