---
import { DashboardContainer } from '~/features/dashboard'
import Main from '~/layouts/Main.astro'

const { user } = Astro.locals

const features = [
  { label: 'Véhicule', desc: 'Profil et kilométrage à jour en un geste.' },
  { label: 'Contrôles', desc: 'Vidange, freins, pneus — savoir quoi et quand.' },
  { label: 'Dépenses', desc: 'Carburant, entretien, réparations, suivis au centime.' },
  { label: 'Budget', desc: 'Mensuel ou annuel, suivi en temps réel.' },
  { label: 'Historique', desc: 'Tout ce qui a été fait, daté.' },
  { label: 'Multi-utilisateur', desc: 'Onboarding par administrateur.' }
] as const
---

<Main title={user ? 'Tableau de bord' : undefined}>
  {
    user ? (
      <section class='container mx-auto px-4 py-8'>
        <DashboardContainer client:only='react' />
      </section>
    ) : (
      <section class='flex flex-col gap-12 py-8 lg:py-16'>
        <header class='text-center'>
          <div class='mb-6 flex justify-center' aria-hidden='true'>
            <span class='bg-primary inline-flex h-16 w-16 items-center justify-center rounded-md'>
              <span class='border-base-100 inline-block h-8 w-8 rounded-full border-4' />
            </span>
          </div>
          <h1 class='font-display mb-3 text-4xl font-bold tracking-[0.15em] uppercase sm:text-5xl'>
            COST<span class='text-primary'>.LOG</span>
          </h1>
          <p class='text-base-content/70 font-mono text-sm tracking-widest uppercase'>
            Le tableau de bord de votre voiture
          </p>
        </header>

        <p class='text-base-content/80 mx-auto max-w-2xl text-center leading-relaxed'>
          <strong class='text-base-content'>COST.LOG</strong> suit chaque kilomètre, chaque dépense
          et chaque contrôle de votre véhicule. Conçu pour comprendre exactement combien votre
          voiture coûte, mois après mois.
        </p>

        <ul class='grid gap-4 sm:grid-cols-2 lg:grid-cols-3' aria-label='Fonctionnalités'>
          {features.map(({ label, desc }) => (
            <li class='border-base-300 bg-base-200 rounded-md border p-4'>
              <h2 class='font-display text-primary mb-1 text-sm tracking-wide uppercase'>
                {label}
              </h2>
              <p class='text-base-content/70 text-sm'>{desc}</p>
            </li>
          ))}
        </ul>

        <div class='text-center'>
          <a href='/auth' class='btn btn-primary btn-lg font-display tracking-wider uppercase'>
            Se connecter
          </a>
        </div>
      </section>
    )
  }
</Main>
