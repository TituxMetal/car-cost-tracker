---
import { ChangePasswordForm, DeleteAccountSection, EditProfileContainer } from '~/features/profile'
import Main from '~/layouts/Main.astro'
import type { User } from '~/types'

const { user } = Astro.locals

if (!user) {
  return Astro.redirect('/auth')
}

const userData = user as User
---

<Main title='Profile'>
  <section class='container mx-auto px-4 py-10'>
    <header class='mb-12 text-center'>
      <h1 class='text-base-content text-4xl font-bold tracking-tight'>
        Welcome {userData.username}
      </h1>
      <p class='text-base-content/70 mt-2 text-sm'>Manage your account settings and preferences</p>
      <nav class='mt-4'>
        <a href='/profile/sessions' class='link link-primary text-sm'>Manage Sessions</a>
      </nav>
    </header>
    <div class='mx-auto flex max-w-2xl flex-col gap-8'>
      <EditProfileContainer client:load userData={userData} />
      <ChangePasswordForm client:load />
      <DeleteAccountSection client:load />
    </div>
  </section>
</Main>
