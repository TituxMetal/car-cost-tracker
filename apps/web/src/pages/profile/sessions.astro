---
import { SessionList } from '~/features/auth'
import Main from '~/layouts/Main.astro'

const { user } = Astro.locals

if (!user) {
  return Astro.redirect('/auth')
}
---

<Main title='Sessions actives'>
  <section class='mx-auto w-full max-w-4xl px-4 py-10'>
    <a
      href='/profile'
      class='text-base-content/60 hover:text-primary mb-6 inline-flex items-center gap-2 font-mono text-[11px] tracking-[0.18em] uppercase transition-colors'
    >
      ← Retour au profil
    </a>
    <header class='mb-10'>
      <p class='text-base-content/60 font-mono text-[10px] tracking-[0.18em] uppercase'>// ACCÈS</p>
      <h1
        class='font-display text-base-content mt-2 text-3xl font-semibold tracking-tight sm:text-4xl'
      >
        Sessions actives
      </h1>
      <p class='text-base-content/60 mt-3 font-mono text-sm tracking-wide'>
        Gérez les sessions ouvertes sur vos appareils.
      </p>
    </header>
    <SessionList client:load />
  </section>
</Main>
